#!/usr/bin/env bash
# SessionStart hook for ontologian plugin

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context="ontologian plugin is active. Use these slash commands to manage your ontology:\\n- /ontologian — Show domain list and status summary\\n- /ontologian-add — Add a new type interactively\\n- /ontologian-analyze — Derive ontology from free-form requirements\\n- /ontologian-search — Search by keyword across all domains\\n- /ontologian-validate — Check YAML schema and referential integrity\\n- /ontologian-sync — Sync to global store\\n- /ontologian-migrate — Migrate domain to per-entity format\\n- /ontologian-visualize — Render ASCII relationship diagram\\n- /ontologian-consult — Start a Palantir-grade ontology consulting session\\n- /ontologian-review — Run 3-round Engineering Head Council review"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
else
  printf '{\n  "additional_context": "%s"\n}\n' "$context"
fi

exit 0
